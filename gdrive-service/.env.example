# Copy to .env and fill in. Loaded automatically at startup via python-dotenv
# (app/config.py calls load_dotenv()); real environment variables still take
# precedence over values here if both are set.

# --- Auth mode ---
# "service_account" (default) or "oauth"
GDRIVE_AUTH_MODE=service_account

# --- service_account mode ---
# Path to a service-account JSON key file. The service account must be added
# as a member (Content Manager or higher) of the target Shared Drive.
GDRIVE_SERVICE_ACCOUNT_FILE=service_account.json

# --- oauth mode ---
# Used to exchange a long-lived refresh token for short-lived access tokens
# at request time. Obtain these once via the standard OAuth 2.0 installed-app
# or web-app consent flow for scope https://www.googleapis.com/auth/drive,
# then keep the refresh token here for reuse (it will not expire unless
# revoked or unused for 6 months).
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REFRESH_TOKEN=
GDRIVE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token

# --- Upload tuning ---
GDRIVE_MAX_WORKERS=32
GDRIVE_MIN_FILE_SIZE=1024
GDRIVE_MAX_FILE_SIZE=2097152
GDRIVE_CHUNK_SIZE=4194304
GDRIVE_MAX_RETRIES=8
GDRIVE_BASE_BACKOFF=1.0
GDRIVE_MAX_BACKOFF=60.0

# --- Pagination ---
GDRIVE_DEFAULT_PAGE_SIZE=100
GDRIVE_MAX_PAGE_SIZE=1000

# --- CORS ---
# Comma-separated list of origins allowed to call this API from a browser
# (e.g. the gdrive-ui frontend). Add your deployed Cloudflare Pages URL here.
GDRIVE_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://gdrive-ui.pages.dev
